#!/bin/bash
#
# shailctl — unified service control for the SHAIL stack.
#
# Single entrypoint for starting, stopping, restarting, and inspecting all
# SHAIL services on this machine. Replaces the proliferation of
# start_*.sh / stop_*.sh / RESTART_ALL.sh scripts that fell out of sync.
#
# Usage:
#   ./shailctl start          start all services in dependency order
#   ./shailctl stop           stop all services (tracked PIDs + port fallback)
#   ./shailctl restart        stop then start
#   ./shailctl status         show what's running and where
#   ./shailctl logs <name>    tail a service's log
#   ./shailctl clean          stop + delete stale PID files + kill zombies
#
# Services managed (in dependency order):
#   ollama (11434) → redis (6379) → ui_twin → action_executor (8080) →
#   vision (8081) → rag_retriever (8082) → planner (8083) →
#   shail_api / FastAPI (8000) → task_worker
#
# This script is the source of truth. Do not call start_shail.sh /
# stop_shail.sh directly — they are kept as legacy fallbacks only.

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_DIR="$ROOT/logs"
PID_DIR="$ROOT/run"
VENV="$ROOT/services_env"
PYTHON_BIN="$VENV/bin/python3"
mkdir -p "$LOG_DIR" "$PID_DIR"

if [ -t 1 ]; then
  C_OK="$(printf '\033[32m')"; C_WARN="$(printf '\033[33m')"
  C_ERR="$(printf '\033[31m')"; C_DIM="$(printf '\033[2m')"
  C_BOLD="$(printf '\033[1m')"; C_RST="$(printf '\033[0m')"
else
  C_OK=""; C_WARN=""; C_ERR=""; C_DIM=""; C_BOLD=""; C_RST=""
fi

log()  { printf '%s[shail]%s %s\n' "$C_DIM" "$C_RST" "$*"; }
ok()   { printf '%s✓%s %s\n' "$C_OK" "$C_RST" "$*"; }
warn() { printf '%s!%s %s\n' "$C_WARN" "$C_RST" "$*"; }
err()  { printf '%s✗%s %s\n' "$C_ERR" "$C_RST" "$*" >&2; }

REQUIRED_PY_DEPS=(bcrypt fastapi uvicorn pydantic pytest httpx langchain_ollama)

venv_broken() {
  if [ ! -x "$PYTHON_BIN" ]; then
    return 0
  fi
  if [ -f "$VENV/bin/pytest" ] && grep -q "/shail workspace /jarvis_master/" "$VENV/bin/pytest" 2>/dev/null; then
    return 0
  fi
  if ! "$PYTHON_BIN" - <<'PY' >/dev/null 2>&1
import sys
raise SystemExit(0 if sys.executable else 1)
PY
  then
    return 0
  fi
  return 1
}

ensure_venv() {
  if venv_broken; then
    warn "services_env is missing or points to an old repo path — recreating it"
    rm -rf "$VENV"
    python3 -m venv "$VENV" || return 1
  fi
  if [ ! -x "$PYTHON_BIN" ]; then
    err "Python venv is missing its interpreter at $PYTHON_BIN"
    return 1
  fi
  local missing
  missing="$("$PYTHON_BIN" - <<'PY'
import importlib.util
mods = ["bcrypt", "fastapi", "uvicorn", "pydantic", "pytest", "httpx", "langchain_ollama"]
print(" ".join(m for m in mods if importlib.util.find_spec(m) is None))
PY
)"
  if [ -n "$missing" ]; then
    warn "installing missing backend dependencies: $missing"
    "$PYTHON_BIN" -m pip install -q -r "$ROOT/requirements.txt" || return 1
  fi
}

python_dep_report() {
  local py="${1:-$PYTHON_BIN}"
  if [ ! -x "$py" ]; then
    printf '  python: %s%s missing%s\n' "$C_ERR" "$py" "$C_RST"
    return 1
  fi
  "$py" - <<'PY'
import importlib.util, sys
print(f"  python: {sys.executable}")
for mod in ["bcrypt", "fastapi", "uvicorn", "pydantic", "pytest", "httpx", "langchain_ollama"]:
    print(f"  {mod}: {'ok' if importlib.util.find_spec(mod) else 'missing'}")
PY
}

backend_import_check() {
  "$PYTHON_BIN" - <<'PY'
import importlib
mods = ["apps.shail.main", "apps.shail.auth_store", "apps.shail.local_rag_api", "apps.shail.system_api"]
for mod in mods:
    importlib.import_module(mod)
    print(f"  import {mod}: ok")
PY
}

# Each entry: name|port|stop_priority(1=first to die, low to high = deps last)
SERVICES=(
  "task_worker|0|1"
  "shail_api|8000|2"
  "planner|8083|3"
  "rag_retriever|8082|3"
  "vision|8081|3"
  "action_executor|8080|3"
  "ui_twin|0|3"
  "memory_watchdog|0|4"
  "native|0|4"
  "redis|6379|5"
  "ollama|11434|6"
)

port_for() {
  local name="$1"
  for s in "${SERVICES[@]}"; do
    IFS='|' read -r n p _ <<< "$s"
    if [ "$n" = "$name" ]; then echo "$p"; return; fi
  done
  echo 0
}

is_alive() {
  local pid="$1"
  [ -n "$pid" ] && [ "$pid" -gt 0 ] 2>/dev/null && ps -p "$pid" >/dev/null 2>&1
}

port_pid() {
  local port="$1"
  [ "$port" -gt 0 ] 2>/dev/null || { echo ""; return; }
  lsof -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null | head -1
}

# ─── stop logic ──────────────────────────────────────────────────────────
# 1. PID file (fast path).
# 2. Port-based fallback (catches orphans from previous botched stops).
# 3. SIGKILL after 4s if SIGTERM didn't take.
stop_one() {
  local name="$1"
  local port="$(port_for "$name")"
  local pid_file="$PID_DIR/${name}.pid"
  local killed=0

  if [ -f "$pid_file" ]; then
    local tpid
    tpid="$(cat "$pid_file" 2>/dev/null | tr -d '[:space:]')"
    if is_alive "$tpid"; then
      log "stopping $name (pid $tpid)"
      kill "$tpid" 2>/dev/null || true
      for _ in 1 2 3 4 5 6 7 8; do
        is_alive "$tpid" || break
        sleep 0.5
      done
      if is_alive "$tpid"; then
        warn "$name didn't exit on SIGTERM — sending SIGKILL"
        kill -9 "$tpid" 2>/dev/null || true
      fi
      killed=1
    fi
    rm -f "$pid_file"
  fi

  if [ "$port" -gt 0 ] 2>/dev/null; then
    local opid
    opid="$(port_pid "$port")"
    if [ -n "$opid" ]; then
      log "killing orphan $name on :$port (pid $opid)"
      kill "$opid" 2>/dev/null || true
      for _ in 1 2 3 4 5 6; do
        opid="$(port_pid "$port")"
        [ -z "$opid" ] && break
        sleep 0.5
      done
      opid="$(port_pid "$port")"
      if [ -n "$opid" ]; then
        kill -9 "$opid" 2>/dev/null || true
      fi
      killed=1
    fi
  fi

  case "$name" in
    ollama)
      pkill -x ollama 2>/dev/null && killed=1 || true
      pkill -f "ollama serve" 2>/dev/null || true
      ;;
    task_worker)
      pkill -f "shail.workers.task_worker" 2>/dev/null && killed=1 || true
      ;;
    ui_twin)
      pkill -f "services/ui_twin/service.py" 2>/dev/null && killed=1 || true
      ;;
  esac

  if [ "$killed" -eq 1 ]; then ok "$name stopped"; fi
}

kill_orphans() {
  local pids
  pids="$(pgrep -f "start_shail.sh" 2>/dev/null || true)"
  if [ -n "$pids" ]; then
    log "reaping orphan start_shail.sh shells: $pids"
    # shellcheck disable=SC2086
    kill $pids 2>/dev/null || true
    sleep 0.5
    pids="$(pgrep -f "start_shail.sh" 2>/dev/null || true)"
    if [ -n "$pids" ]; then
      # shellcheck disable=SC2086
      kill -9 $pids 2>/dev/null || true
    fi
    ok "orphan shells cleared"
  fi
}

cmd_stop() {
  log "stopping SHAIL stack"
  local sorted
  sorted=$(for s in "${SERVICES[@]}"; do
    IFS='|' read -r n _ pri <<< "$s"
    printf '%s %s\n' "$pri" "$n"
  done | sort -n | awk '{print $2}')
  for name in $sorted; do
    stop_one "$name"
  done
  kill_orphans
  ok "all services stopped"
}

cmd_start() {
  ensure_venv || return 1
  if [ -x "$ROOT/start_shail.sh" ]; then
    log "starting SHAIL stack via start_shail.sh"
    "$ROOT/start_shail.sh"
  else
    err "start_shail.sh not found or not executable"
    return 1
  fi
}

cmd_restart() {
  cmd_stop
  sleep 1
  cmd_start
}

cmd_status() {
  printf '%s%s%s\n' "$C_BOLD" "SHAIL service status" "$C_RST"
  printf '%-20s %-8s %-20s %-7s %s\n' "SERVICE" "PORT" "STATE" "PID" "SOURCE"
  printf '%-20s %-8s %-20s %-7s %s\n' "──────" "────" "─────" "───" "──────"
  for s in "${SERVICES[@]}"; do
    IFS='|' read -r name port _ <<< "$s"
    local pid_file="$PID_DIR/${name}.pid"
    local tpid="" opid="" state="${C_DIM}stopped${C_RST}" source="-"
    if [ -f "$pid_file" ]; then
      tpid="$(cat "$pid_file" 2>/dev/null | tr -d '[:space:]')"
    fi
    if [ "$port" -gt 0 ] 2>/dev/null; then
      opid="$(port_pid "$port")"
    fi
    if is_alive "$tpid"; then
      state="${C_OK}running${C_RST}"; source="pid-file"
    elif [ -n "$opid" ]; then
      state="${C_WARN}running${C_RST}"; source="port (untracked)"; tpid="$opid"
    fi
    printf '%-20s %-8s %-20b %-7s %s\n' \
      "$name" "${port:-—}" "$state" "${tpid:-—}" "$source"
  done

  echo
  if curl -fsS --max-time 1 http://127.0.0.1:8000/health >/dev/null 2>&1; then
    ok "backend /health responds"
  else
    warn "backend /health not responding"
  fi
  if curl -fsS --max-time 1 http://localhost:11434/api/tags >/dev/null 2>&1; then
    ok "ollama /api/tags responds"
  else
    warn "ollama not reachable"
  fi
}

cmd_logs() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    log "available logs:"
    ls -1 "$LOG_DIR" 2>/dev/null | sed 's/^/  /' || true
    return
  fi
  local f="$LOG_DIR/${name}.log"
  if [ ! -f "$f" ]; then
    err "no log at $f"
    return 1
  fi
  exec tail -f "$f"
}

cmd_clean() {
  cmd_stop
  log "removing stale PID files"
  rm -f "$PID_DIR"/*.pid 2>/dev/null || true
  ok "clean complete"
}

# ─── api: fast backend-only restart (Ollama/Redis/native untouched) ──────────
# Use this during development — it's 3-4 seconds vs 30+ for a full restart.
# Also force-kills any frozen uvicorn before starting fresh, which a plain
# restart misses when the event loop is blocked.
cmd_api_restart() {
  log "restarting shail_api only"

  # Force-kill any uvicorn holding port 8000 (PID file + port fallback)
  local pid_file="$PID_DIR/shail_api.pid"
  if [ -f "$pid_file" ]; then
    local tpid
    tpid="$(cat "$pid_file" 2>/dev/null | tr -d '[:space:]')"
    if is_alive "$tpid"; then
      kill "$tpid" 2>/dev/null || true
      sleep 1
      is_alive "$tpid" && kill -9 "$tpid" 2>/dev/null || true
    fi
    rm -f "$pid_file"
  fi
  local opid
  opid="$(port_pid 8000)"
  if [ -n "$opid" ]; then
    log "force-killing orphan on :8000 (pid $opid)"
    kill -9 "$opid" 2>/dev/null || true
    sleep 1
  fi

  # Verify port is clear
  opid="$(port_pid 8000)"
  if [ -n "$opid" ]; then
    err "port 8000 still occupied by PID $opid — abort"
    return 1
  fi

  # Start fresh
  ensure_venv || return 1
  local py="$PYTHON_BIN"
  [ -x "$py" ] || py="$VENV/bin/python3.9"
  PYTHONPATH="$ROOT" nohup "$py" -m uvicorn apps.shail.main:app \
    --host 127.0.0.1 --port 8000 \
    </dev/null >"$LOG_DIR/shail_api.log" 2>&1 &
  local new_pid=$!
  disown "$new_pid" 2>/dev/null || true
  echo "$new_pid" >"$pid_file"
  log "shail_api starting (pid $new_pid) — waiting for :8000"

  local waited=0
  until [ -n "$(port_pid 8000)" ] || [ "$waited" -ge 20 ]; do
    sleep 1; waited=$((waited + 1)); printf "."
  done
  echo

  if port_pid 8000 >/dev/null 2>&1; then
    ok "shail_api up on :8000"
    # Quick health check
    sleep 1
    python3 -c "
import urllib.request, json
try:
    r = urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4)
    d = json.loads(r.read())
    print(f'  status={d[\"status\"]}  ollama={d[\"ollama_reachable\"]}  chroma={d[\"chroma_ready\"]}')
except Exception as e:
    print(f'  health not yet ready: {e}')
" 2>/dev/null || true
  else
    err "shail_api failed to bind — check logs/shail_api.log"
    tail -20 "$LOG_DIR/shail_api.log" 2>/dev/null
    return 1
  fi
}

cmd_health() {
  echo "=== Service ports ==="
  for port in 8000 11434 6379; do
    local pid
    pid="$(port_pid "$port")"
    if [ -n "$pid" ]; then
      printf "  :%s  %s(pid %s)%s\n" "$port" "$C_OK" "$pid" "$C_RST"
    else
      printf "  :%s  %s(not listening)%s\n" "$port" "$C_ERR" "$C_RST"
    fi
  done
  echo
  echo "=== Python environment ==="
  python_dep_report "$PYTHON_BIN" || true
  echo
  echo "=== Backend imports ==="
  if [ -x "$PYTHON_BIN" ]; then
    backend_import_check 2>&1 || true
  else
    echo "  ERROR: missing $PYTHON_BIN"
  fi
  echo
  echo "=== Backend health ==="
  python3 -c "
import urllib.request, json, sys
try:
    r = urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4)
    d = json.loads(r.read())
    for k, v in d.items():
        print(f'  {k}: {v}')
except Exception as e:
    print(f'  ERROR: {e}', file=sys.stderr)
    sys.exit(1)
" 2>&1
  echo
  echo "=== Backend readiness ==="
  python3 -c "
import urllib.request, json, sys
try:
    r = urllib.request.urlopen('http://127.0.0.1:8000/system/readiness', timeout=4)
    d = json.loads(r.read())
    print(f'  status: {d.get(\"status\")}')
    for name, check in (d.get('checks') or {}).items():
        print(f'  {name}: {\"ok\" if check.get(\"ok\") else \"failed\"}')
        if check.get('error'):
            print(f'    error: {check.get(\"error\")}')
        if check.get('missing'):
            print(f'    missing: {\", \".join(check.get(\"missing\") or [])}')
except Exception as e:
    print(f'  ERROR: {e}', file=sys.stderr)
    sys.exit(1)
" 2>&1
}

cmd_doctor() {
  local failed=0
  printf '%s%s%s\n' "$C_BOLD" "SHAIL doctor" "$C_RST"

  echo "=== Venv ==="
  if ensure_venv; then ok "services_env ready"; else failed=1; fi
  python_dep_report "$PYTHON_BIN" || failed=1

  echo
  echo "=== Backend import ==="
  if backend_import_check; then ok "backend imports"; else failed=1; fi

  echo
  echo "=== Live endpoints ==="
  if ! curl -fsS --max-time 2 "http://127.0.0.1:8000/health" >/dev/null 2>&1; then
    warn "backend not reachable — starting shail_api for doctor"
    if ! cmd_api_restart; then
      failed=1
    fi
  elif ! curl -fsS --max-time 2 "http://127.0.0.1:8000/system/readiness" >/dev/null 2>&1; then
    warn "backend is running old routes — restarting shail_api for doctor"
    if ! cmd_api_restart; then
      failed=1
    fi
  fi
  for url in \
    "http://127.0.0.1:8000/health" \
    "http://127.0.0.1:8000/system/readiness" \
    "http://127.0.0.1:8000/local-rag/status"; do
    local extra=""
    [ "$url" = "http://127.0.0.1:8000/local-rag/status" ] && extra="401"
    local final_code=""
    if final_code="$(endpoint_ready "$url" "$extra")"; then
      ok "$url"
    else
      warn "$url not reachable (HTTP ${final_code:-000})"
      failed=1
    fi
  done

  echo
  echo "=== UI builds ==="
  if (cd "$ROOT/apps/shail-ui" && npm run build >/dev/null); then
    ok "dashboard build"
  else
    failed=1
    err "dashboard build failed"
  fi
  if (cd "$ROOT/shail-extension" && npm run build >/dev/null); then
    ok "extension build"
  else
    failed=1
    err "extension build failed"
  fi

  if [ "$failed" -eq 0 ]; then
    ok "doctor passed"
  else
    err "doctor found issues"
  fi
  return "$failed"
}

endpoint_ready() {
  local url="$1"
  local allowed_extra="${2:-}"
  local code=""
  for _ in 1 2 3 4 5 6 7 8; do
    code="$(curl -sS --max-time 4 -o /dev/null -w '%{http_code}' "$url" 2>/dev/null || echo 000)"
    if [ "$code" = "200" ] || { [ -n "$allowed_extra" ] && [ "$code" = "$allowed_extra" ]; }; then
      return 0
    fi
    sleep 1
  done
  printf '%s' "$code"
  return 1
}

case "${1:-}" in
  start)           cmd_start ;;
  stop)            cmd_stop ;;
  restart)         cmd_restart ;;
  api|api-restart) cmd_api_restart ;;
  health|h)        cmd_health ;;
  doctor)          cmd_doctor ;;
  status|st)       cmd_status ;;
  logs)            cmd_logs "${2:-}" ;;
  clean)           cmd_clean ;;
  ""|-h|--help|help)
    cat <<EOF
Usage: ./shailctl <command>

Commands:
  start              Start the full SHAIL stack (Ollama → Redis → API → workers)
  stop               Stop everything (tracked + orphaned)
  restart            Stop then start (full stack, ~30s)
  api                Fast backend-only restart (~4s). Use during development.
  health             Print live health status of all services
  doctor             Verify venv, imports, live endpoints, and UI builds
  status             Show running services and ports
  logs <service>     Tail logs/<service>.log
  clean              Stop and delete stale PID files

Services in dependency order:
  ollama → redis → ui_twin → action_executor → vision →
  rag_retriever → planner → shail_api → task_worker

Examples:
  ./shailctl api          # restart only the FastAPI backend (fastest)
  ./shailctl health       # check everything is alive
  ./shailctl status       # full service table
  ./shailctl restart      # full stack restart
  ./shailctl logs shail_api
EOF
    ;;
  *)
    err "unknown command: $1"
    err "run './shailctl help' for usage"
    exit 1
    ;;
esac
